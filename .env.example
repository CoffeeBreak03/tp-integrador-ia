# Azure AI Foundry Credentials
# Configure these in Netlify Dashboard → Site settings → Build & deploy → Environment
AZURE_FOUNDRY_ENDPOINT=https://your-region.openai.azure.com
AZURE_FOUNDRY_API_KEY=your-api-key-here
AZURE_FOUNDRY_MODEL_VISION=gpt-4-vision
AZURE_FOUNDRY_MODEL_TRANSLATE=gpt-4-turbo

# Environment
NODE_ENV=development

# Netlify (used by deploy preview)
NETLIFY=false
NETLIFY_AUTH_TOKEN=your-token-here
NETLIFY_SITE_ID=your-site-id-here
